#!/bin/sh
. "$(dirname "$0")/_/husky.sh"

echo "🔍 Running server ESLint..."
(cd tenebra-server && npm run lint)

echo ""
echo "🔍 Running web lint..."
(cd tenebra-web && npm run lint)

echo ""
echo "Running Semgrep security checks..."
if command -v semgrep >/dev/null 2>&1; then
  semgrep scan \
    --config=p/security-audit \
    --config=p/secrets \
    --config=p/owasp-top-ten \
    --config=p/nodejs \
    --config=p/react \
    --config=p/typescript \
    --error \
    --quiet \
    || {
      echo "❌ Semgrep found security issues!"
      echo "To skip this check (not recommended): git commit --no-verify"
      exit 1
    }
  echo "✅ Semgrep checks passed!"
else
  echo "⚠️  Semgrep not installed. Install with: pip install semgrep"
  echo "   Skipping Semgrep checks..."
fi
